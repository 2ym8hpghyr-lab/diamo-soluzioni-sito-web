# ──────────────────────────────────────────────────────────────
# Diamo Soluzioni — variabili d'ambiente
# Copia questo file in .env.local e compila i valori reali.
# NON committare mai .env.local nel repository.
# ──────────────────────────────────────────────────────────────

# URL pubblico del sito (senza trailing slash)
# In Vercel: impostato automaticamente come VERCEL_URL, ma serve il dominio definitivo
NEXT_PUBLIC_SITE_URL=https://www.diamosoluzioni.it

# Anthropic — AI preventivatore e chatbot
# Dashboard: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Google Analytics 4
# Formato: G-XXXXXXXXXX (trovare in Analytics > Amministrazione > Flussi di dati)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ──────────────────────────────────────────────────────────────
# NOTIFICHE LEAD — email (Resend)
# Dashboard: https://resend.com
# ──────────────────────────────────────────────────────────────
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=notifiche@diamosoluzioni.it
NOTIFICATION_EMAIL=pellumbmurgu@gmail.com

# ──────────────────────────────────────────────────────────────
# NOTIFICHE LEAD — WhatsApp (Twilio) — OPZIONALE
# Se non si usa Twilio, lasciare vuoti. Le email funzionano comunque.
# Dashboard: https://console.twilio.com
# ──────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_TO=whatsapp:+393444619461
